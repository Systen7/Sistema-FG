# Conexão com o PostgreSQL
DATABASE_URL=postgres://fg:fg@localhost:5432/fg
# Segredo para assinar as sessões (gere com: openssl rand -base64 32)
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Endereço público do sistema, usado nos links de acesso enviados aos motoristas
APP_URL=http://localhost:3000
# Fuso horário da operação
TZ_EMPRESA=America/Sao_Paulo

# Testes de integração (banco só para testes; o nome precisa conter "test")
# TEST_DATABASE_URL=postgres://fg:fg@localhost:5432/fg_teste

# Observabilidade (opcional; sem isto nada é enviado para fora)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_AUTH_TOKEN=          # só para enviar source maps no build
# SENTRY_ORG=
# SENTRY_PROJECT=
